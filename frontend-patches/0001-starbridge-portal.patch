+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { AppearanceProvider, ThemeProvider, ToastProvider } from "@code-proxy/ui";
+const api = vi.hoisted(() => ({ login: vi.fn(), logout: vi.fn(), clearSession: vi.fn() }));
+vi.mock("@code-proxy/api-client", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@code-proxy/api-client")>()),
+  portalApi: api,
+}));
+vi.mock("../LoginNetwork", () => ({ LoginNetwork: () => null }));
+vi.mock("../RotatingModelName", () => ({ RotatingModelName: () => <span>Models</span> }));
+import { PortalLoginPage } from "../LoginPage";
+import { PortalRegisterPage } from "../PortalRegisterPage";
+import { portalNavigation } from "../portalAuth";
+
+function renderFlow(path = "/portal-login") {
+  return render(
+    <MemoryRouter initialEntries={[path]}>
+      <ThemeProvider>
+        <AppearanceProvider>
+          <ToastProvider>
+            <Routes>
+              <Route path="/portal-login" element={<PortalLoginPage />} />
+              <Route path="/portal-register" element={<PortalRegisterPage />} />
+            </Routes>
+          </ToastProvider>
+        </AppearanceProvider>
+      </ThemeProvider>
+    </MemoryRouter>,
+  );
+}
+beforeEach(() => {
+  vi.restoreAllMocks();
+  api.login.mockReset();
+  api.logout.mockReset();
+  api.clearSession.mockReset();
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(
+      async (url: string) =>
+        new Response(
+          JSON.stringify(
+            url.includes("registration")
+              ? { enabled: true, password_min_length: 12, password_max_bytes: 72 }
+              : { user: { username: "star_user" } },
+          ),
+          {
+            status: url.endsWith("register") ? 201 : 200,
+            headers: { "Content-Type": "application/json" },
+          },
+        ),
+    ),
+  );
+});
+describe("ordinary account authentication flow", () => {
+  test("uses the shared login form with portal authentication and a registration link", async () => {
+    const workspace = vi.spyOn(portalNavigation, "openWorkspace").mockImplementation(() => {});
+    api.login.mockResolvedValue({ user: { must_change_password: false } });
+    const { container } = renderFlow();
+    expect(
+      await screen.findByRole("link", { name: /Create an account|立即注册|Зарегистрироваться/i }),
+    ).toHaveAttribute("href", "/portal-register");
+    expect(container.textContent).toContain("星桥 StarBridge");
+    fireEvent.change(container.querySelector('input[autocomplete="username"]')!, {
+      target: { value: "star_user" },
+    });
+    fireEvent.change(container.querySelector('input[autocomplete="current-password"]')!, {
+      target: { value: "Signup-Password-123!" },
+    });
+    fireEvent.submit(container.querySelector("form")!);
+    await waitFor(() => expect(workspace).toHaveBeenCalledOnce());
+    expect(api.login).toHaveBeenCalledWith("star_user", "Signup-Password-123!", false);
+  });
+  test("registration validates confirmation then returns to login with username prefilled", async () => {
+    const { container } = renderFlow("/portal-register");
+    await waitFor(() => expect(container.querySelector("fieldset")).not.toBeDisabled());
+    fireEvent.change(container.querySelector('input[autocomplete="username"]')!, {
+      target: { value: "star_user" },
+    });
+    const passwords = container.querySelectorAll('input[autocomplete="new-password"]');
+    fireEvent.change(passwords[0], { target: { value: "Signup-Password-123!" } });
+    fireEvent.change(passwords[1], { target: { value: "Mismatch-Password-123!" } });
+    fireEvent.submit(container.querySelector("form")!);
+    expect(await screen.findByRole("alert")).toHaveTextContent(/do not match|不一致|не совпадают/i);
+    fireEvent.change(passwords[1], { target: { value: "Signup-Password-123!" } });
+    fireEvent.submit(container.querySelector("form")!);
+    await waitFor(() =>
+      expect(container.querySelector('input[autocomplete="current-password"]')).toBeInTheDocument(),
+    );
+    expect(container.querySelector('input[autocomplete="username"]')).toHaveValue("star_user");
+    expect(vi.mocked(fetch)).toHaveBeenCalledWith(
+      "/v0/portal/auth/register",
+      expect.objectContaining({
+        body: JSON.stringify({
+          username: "star_user",
+          display_name: "",
+          password: "Signup-Password-123!",
+        }),
+      }),
+    );
+  });
+  test("sign-out waits for revocation then opens unified login even if the server is offline", async () => {
+    let finish!: () => void;
+    api.logout.mockImplementation(
+      () =>
+        new Promise<void>((resolve) => {
+          finish = resolve;
+        }),
+    );
+    const login = vi.spyOn(portalNavigation, "openLogin").mockImplementation(() => {});
+    const pending = portalNavigation.signOut();
+    expect(login).not.toHaveBeenCalled();
+    finish();
+    await pending;
+    expect(api.clearSession).toHaveBeenCalledOnce();
+    expect(login).toHaveBeenCalledOnce();
+    api.logout.mockRejectedValue(new Error("offline"));
+    await portalNavigation.signOut();
+    expect(login).toHaveBeenCalledTimes(2);
+  });
+});
