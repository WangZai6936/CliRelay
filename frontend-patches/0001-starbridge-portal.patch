+import { fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import i18n from "@code-proxy/i18n";
+import { AppearanceProvider, ThemeProvider, ToastProvider } from "@code-proxy/ui";
+import type { ReactNode } from "react";
+const mocks = vi.hoisted(() => ({
+  publicItems: vi.fn(),
+  get: vi.fn(),
+  save: vi.fn(),
+  canWrite: true,
+}));
+vi.mock("../modelShowcase", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../modelShowcase")>()),
+  fetchPublicShowcase: mocks.publicItems,
+  showcaseSettingsApi: { get: mocks.get, save: mocks.save },
+}));
+vi.mock("@app/providers/AuthProvider", () => ({
+  useOptionalAuth: () => ({
+    can: (permission: string) => permission.endsWith(".read") || mocks.canWrite,
+  }),
+}));
+import { SupportedModelsButton } from "../SupportedModelsButton";
+import { PortalShowcaseSettings } from "../../config/PortalShowcaseSettings";
+const wrap = (children: ReactNode) =>
+  render(
+    <ThemeProvider>
+      <AppearanceProvider>
+        <ToastProvider>{children}</ToastProvider>
+      </AppearanceProvider>
+    </ThemeProvider>,
+  );
+beforeEach(async () => {
+  vi.clearAllMocks();
+  mocks.canWrite = true;
+  await i18n.changeLanguage("en");
+});
+describe("public model showcase", () => {
+  test("opens only on click, renders configured order and fetches updates when reopened", async () => {
+    mocks.publicItems
+      .mockResolvedValueOnce([
+        { name: "Gemini", icon: "gemini" },
+        { name: "Claude", icon: "claude" },
+      ])
+      .mockResolvedValueOnce([{ name: "GPT", icon: "gpt" }]);
+    wrap(<SupportedModelsButton />);
+    expect(mocks.publicItems).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByRole("button", { name: "See supported models" }));
+    const dialog = await screen.findByRole("dialog");
+    await within(dialog).findByText("Gemini");
+    expect(
+      within(dialog)
+        .getAllByRole("listitem")
+        .map((item) => item.textContent),
+    ).toEqual(["Gemini", "Claude"]);
+    fireEvent.click(within(dialog).getAllByRole("button", { name: /Close/i }).at(-1)!);
+    await waitFor(() => expect(screen.queryByRole("dialog")).not.toBeInTheDocument());
+    fireEvent.click(screen.getByRole("button", { name: "See supported models" }));
+    expect(await screen.findByText("GPT")).toBeInTheDocument();
+    expect(mocks.publicItems).toHaveBeenCalledTimes(2);
+  });
+  test("shows a retryable error and a proper empty state", async () => {
+    mocks.publicItems.mockRejectedValueOnce(new Error("offline")).mockResolvedValueOnce([]);
+    wrap(<SupportedModelsButton />);
+    fireEvent.click(screen.getByRole("button", { name: "See supported models" }));
+    expect(await screen.findByRole("alert")).toHaveTextContent("Could not load");
+    fireEvent.click(screen.getByRole("button", { name: "Retry" }));
+    expect(
+      await screen.findByText("The model list has not been published yet."),
+    ).toBeInTheDocument();
+  });
+});
+describe("showcase administration", () => {
+  test("edits names, changes order and saves the versioned list", async () => {
+    const settings = {
+      items: [
+        { name: "Claude", icon: "claude" },
+        { name: "GPT", icon: "gpt" },
+      ],
+      available_icons: ["claude", "gpt"],
+      version: 3,
+    };
+    mocks.get.mockResolvedValue(settings);
+    mocks.save.mockResolvedValue({});
+    wrap(<PortalShowcaseSettings />);
+    expect(await screen.findByRole("textbox", { name: "Display name 1" })).toHaveValue("Claude");
+    fireEvent.click(screen.getByRole("button", { name: "Move down 1" }));
+    expect(screen.getByRole("textbox", { name: "Display name 1" })).toHaveValue("GPT");
+    fireEvent.change(screen.getByRole("textbox", { name: "Display name 1" }), {
+      target: { value: "GPT models" },
+    });
+    fireEvent.click(screen.getByRole("button", { name: "Save showcase" }));
+    await waitFor(() =>
+      expect(mocks.save).toHaveBeenCalledWith(
+        [
+          { name: "GPT models", icon: "gpt" },
+          { name: "Claude", icon: "claude" },
+        ],
+        3,
+      ),
+    );
+  });
+  test("read-only access disables editing and saving", async () => {
+    mocks.canWrite = false;
+    mocks.get.mockResolvedValue({
+      items: [{ name: "GPT", icon: "gpt" }],
+      available_icons: ["gpt"],
+      version: 1,
+    });
+    wrap(<PortalShowcaseSettings />);
+    expect(await screen.findByRole("textbox", { name: "Display name 1" })).toBeDisabled();
+    expect(screen.getByRole("button", { name: "Save showcase" })).toBeDisabled();
+    expect(mocks.save).not.toHaveBeenCalled();
+  });
+});
