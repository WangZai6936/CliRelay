+import { apiClient } from "@code-proxy/api-client";
+export interface ShowcaseModel {
+  name: string;
+  icon: string;
+}
+export interface ShowcaseSettings {
+  items: ShowcaseModel[];
+  available_icons: string[];
+  version: number;
+}
+export const showcaseSettingsApi = {
+  get: () => apiClient.get<ShowcaseSettings>("/portal-model-showcase"),
+  save: (items: ShowcaseModel[], version: number) =>
+    apiClient.put("/portal-model-showcase", { items, version }),
+};
+export async function fetchPublicShowcase(signal?: AbortSignal): Promise<ShowcaseModel[]> {
+  const response = await fetch("/v0/portal/model-showcase", {
+    credentials: "omit",
+    cache: "no-store",
+    signal,
+  });
+  if (!response.ok) throw new Error("Unable to load model showcase");
+  const data = await response.json();
+  if (!Array.isArray(data.items)) throw new Error("Invalid model showcase");
+  return data.items;
+}
