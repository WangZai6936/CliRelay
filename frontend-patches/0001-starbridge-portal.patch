diff --git a/pages/config/PortalShowcaseSettings.tsx b/pages/config/PortalShowcaseSettings.tsx
new file mode 100644
index 0000000..c5c6d14
--- /dev/null
+++ b/pages/config/PortalShowcaseSettings.tsx
@@ -0,0 +1,234 @@
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { ArrowDown, ArrowUp, Box, Plus, Trash2 } from "lucide-react";
+import { VendorIcon } from "@code-proxy/assets";
+import { useOptionalAuth } from "@app/providers/AuthProvider";
+import { Button, Callout, TextInput, surface, useToast } from "@code-proxy/ui";
+import { showcaseCopy, showcaseSettingsApi, type ShowcaseModel } from "../login/modelShowcase";
+
+const iconNames: Record<string, string> = {
+  claude: "Claude",
+  gemini: "Gemini",
+  gpt: "GPT",
+  grok: "Grok",
+  qwen: "Qwen",
+  deepseek: "DeepSeek",
+  codex: "Codex",
+  kimi: "Kimi",
+  glm: "GLM",
+  minimax: "MiniMax",
+  hunyuan: "Hunyuan",
+  mimo: "MiMo",
+  ollama: "Ollama",
+  vertex: "Vertex",
+  custom: "Custom",
+};
+export function PortalShowcaseSettings() {
+  const { i18n } = useTranslation();
+  const text = showcaseCopy(i18n.language);
+  const auth = useOptionalAuth();
+  const canRead = auth?.can("system.config.read") ?? false;
+  const canWrite = auth?.can("system.config.write") ?? false;
+  const { notify } = useToast();
+  const [items, setItems] = useState<ShowcaseModel[]>([]);
+  const [icons, setIcons] = useState<string[]>([]);
+  const [baseline, setBaseline] = useState("[]");
+  const [version, setVersion] = useState(0);
+  const [loading, setLoading] = useState(true);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState("");
+  const [retry, setRetry] = useState(0);
+  useEffect(() => {
+    if (!canRead) return;
+    let active = true;
+    setLoading(true);
+    setError("");
+    void showcaseSettingsApi
+      .get()
+      .then((data) => {
+        if (!active) return;
+        setItems(data.items);
+        setBaseline(JSON.stringify(data.items));
+        setIcons(data.available_icons);
+        setVersion(data.version);
+      })
+      .catch(() => {
+        if (active) setError(text.error);
+      })
+      .finally(() => {
+        if (active) setLoading(false);
+      });
+    return () => {
+      active = false;
+    };
+  }, [canRead, retry, text.error]);
+  const disabled = loading || saving || !canWrite;
+  function edit(index: number, value: Partial<ShowcaseModel>) {
+    setItems((current) => current.map((item, at) => (at === index ? { ...item, ...value } : item)));
+  }
+  function move(index: number, delta: number) {
+    setItems((current) => {
+      const next = [...current];
+      [next[index], next[index + delta]] = [next[index + delta], next[index]];
+      return next;
+    });
+  }
+  async function save() {
+    const normalized = items.map((item) => ({ name: item.name.trim(), icon: item.icon }));
+    if (
+      normalized.length > 50 ||
+      normalized.some(
+        (item) => !item.name || [...item.name].length > 80 || /[\r\n\t]/.test(item.name),
+      ) ||
+      new Set(normalized.map((item) => item.name.toLowerCase())).size !== normalized.length
+    ) {
+      setError(text.invalid);
+      return;
+    }
+    setSaving(true);
+    setError("");
+    try {
+      await showcaseSettingsApi.save(normalized, version);
+      const latest = await showcaseSettingsApi.get();
+      setItems(latest.items);
+      setBaseline(JSON.stringify(latest.items));
+      setVersion(latest.version);
+      notify({ type: "success", message: text.saved });
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : text.error);
+    } finally {
+      setSaving(false);
+    }
+  }
+  if (!canRead) return null;
+  return (
+    <section
+      className={`space-y-5 p-5 sm:p-6 ${surface({ radius: "2xl" })}`}
+      aria-busy={loading || saving}
+    >
+      <div>
+        <h2 className="text-lg font-semibold text-ink">{text.settings}</h2>
+        <p className="mt-2 max-w-2xl text-sm leading-6 text-ink-3">{text.settingsHint}</p>
+      </div>
+      {error ? (
+        <Callout tone="danger" role="alert">
+          {error}
+        </Callout>
+      ) : null}
+      {loading ? (
+        <p role="status" className="py-8 text-sm text-ink-3">
+          {text.loading}
+        </p>
+      ) : (
+        <>
+          <ol className="space-y-3">
+            {items.map((item, index) => (
+              <li
+                key={index}
+                className="grid grid-cols-[28px_minmax(0,1fr)] items-start gap-3 rounded-2xl bg-subtle p-4 sm:grid-cols-[28px_minmax(110px,150px)_minmax(100px,1fr)_auto]"
+              >
+                <span className="flex h-10 items-center justify-center">
+                  {item.icon === "custom" ? (
+                    <Box size={24} />
+                  ) : (
+                    <VendorIcon modelId={item.icon} size={25} />
+                  )}
+                </span>
+                <label className="min-w-0">
+                  <span className="sr-only">
+                    {text.icon} {index + 1}
+                  </span>
+                  <select
+                    aria-label={`${text.icon} ${index + 1}`}
+                    disabled={disabled}
+                    value={item.icon}
+                    onChange={(event) => edit(index, { icon: event.target.value })}
+                    className="h-10 w-full rounded-xl border border-edge bg-surface px-3 text-sm text-ink"
+                  >
+                    {icons.map((icon) => (
+                      <option value={icon} key={icon}>
+                        {iconNames[icon] || icon}
+                      </option>
+                    ))}
+                  </select>
+                </label>
+                <TextInput
+                  aria-label={`${text.name} ${index + 1}`}
+                  value={item.name}
+                  maxLength={80}
+                  disabled={disabled}
+                  onChange={(event) => edit(index, { name: event.target.value })}
+                  className="col-start-2 sm:col-start-auto"
+                />
+                <div className="col-start-2 flex gap-1 sm:col-start-auto">
+                  <button
+                    type="button"
+                    title={text.up}
+                    aria-label={`${text.up} ${index + 1}`}
+                    disabled={disabled || index === 0}
+                    onClick={() => move(index, -1)}
+                    className="rounded-full p-2 text-ink-3 hover:bg-hover disabled:opacity-30"
+                  >
+                    <ArrowUp size={17} />
+                  </button>
+                  <button
+                    type="button"
+                    title={text.down}
+                    aria-label={`${text.down} ${index + 1}`}
+                    disabled={disabled || index === items.length - 1}
+                    onClick={() => move(index, 1)}
+                    className="rounded-full p-2 text-ink-3 hover:bg-hover disabled:opacity-30"
+                  >
+                    <ArrowDown size={17} />
+                  </button>
+                  <button
+                    type="button"
+                    title={text.remove}
+                    aria-label={`${text.remove} ${index + 1}`}
+                    disabled={disabled}
+                    onClick={() => setItems((current) => current.filter((_, at) => at !== index))}
+                    className="rounded-full p-2 text-ink-3 hover:bg-hover disabled:opacity-30"
+                  >
+                    <Trash2 size={17} />
+                  </button>
+                </div>
+              </li>
+            ))}
+          </ol>
+          {!items.length ? (
+            <p className="rounded-2xl bg-subtle px-4 py-6 text-sm text-ink-3">{text.empty}</p>
+          ) : null}
+          <div className="flex flex-wrap items-center justify-between gap-3">
+            <div className="flex gap-3">
+              <Button
+                variant="secondary"
+                disabled={disabled || items.length >= 50}
+                onClick={() =>
+                  setItems((current) => [...current, { name: "", icon: icons[0] || "custom" }])
+                }
+              >
+                <Plus size={16} />
+                {text.add}
+              </Button>
+              <Button
+                variant="secondary"
+                disabled={loading || saving}
+                onClick={() => setRetry((value) => value + 1)}
+              >
+                {text.refresh}
+              </Button>
+            </div>
+            <Button
+              variant="primary"
+              loading={saving}
+              disabled={disabled || JSON.stringify(items) === baseline}
+              onClick={() => void save()}
+            >
+              {text.save}
+            </Button>
+          </div>
+        </>
+      )}
+    </section>
+  );
+}
