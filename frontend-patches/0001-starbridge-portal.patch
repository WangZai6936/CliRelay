+++ b/pages/login/PortalRegisterPage.tsx
@@ -0,0 +1,205 @@
+import { useEffect, useRef, useState, type FormEvent } from "react";
+import { Link, useNavigate } from "react-router-dom";
+import { useTranslation } from "react-i18next";
+import { BRAND_NAME_PREFIX, BRAND_NAME_SUFFIX, LogoMark } from "@code-proxy/assets";
+import { Button, Callout, PageBackground, TextInput, ThemeToggleButton } from "@code-proxy/ui";
+import { LoginNetwork } from "./LoginNetwork";
+import { RotatingModelName } from "./RotatingModelName";
+import { portalCopy, registrationCapabilities } from "./portalAuth";
+
+export function PortalRegisterPage() {
+  const { t, i18n } = useTranslation();
+  const text = portalCopy(i18n.language);
+  const navigate = useNavigate();
+  const cardRef = useRef<HTMLDivElement>(null);
+  const [enabled, setEnabled] = useState(false);
+  const [checking, setChecking] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [username, setUsername] = useState("");
+  const [nickname, setNickname] = useState("");
+  const [password, setPassword] = useState("");
+  const [confirm, setConfirm] = useState("");
+  const [policy, setPolicy] = useState({ min: 12, max: 72 });
+  useEffect(() => {
+    let active = true;
+    void registrationCapabilities()
+      .then((data) => {
+        if (!active) return;
+        setEnabled(data.enabled);
+        setPolicy({ min: data.password_min_length, max: data.password_max_bytes });
+        if (!data.enabled) setError("closed");
+      })
+      .catch(() => {
+        if (active) setError("unavailable");
+      })
+      .finally(() => {
+        if (active) setChecking(false);
+      });
+    return () => {
+      active = false;
+    };
+  }, []);
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (busy || !enabled) return;
+    if (password !== confirm) {
+      setError("mismatch");
+      return;
+    }
+    if (new TextEncoder().encode(password).length > policy.max) {
+      setError("tooLong");
+      return;
+    }
+    setBusy(true);
+    setError("");
+    try {
+      const response = await fetch("/v0/portal/auth/register", {
+        method: "POST",
+        credentials: "omit",
+        cache: "no-store",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          username: username.trim(),
+          display_name: nickname.trim(),
+          password,
+        }),
+        signal: AbortSignal.timeout(20000),
+      });
+      const data = await response.json().catch(() => ({}));
+      if (!response.ok) {
+        const code = data.error?.code;
+        if (code === "registration_disabled") setEnabled(false);
+        setError(
+          response.status === 429
+            ? "throttled"
+            : code === "username_taken"
+              ? "taken"
+              : code === "registration_disabled"
+                ? "closed"
+                : response.status === 400
+                  ? "invalid"
+                  : "unavailable",
+        );
+        return;
+      }
+      setPassword("");
+      setConfirm("");
+      navigate("/portal-login", {
+        replace: true,
+        state: { registeredUsername: data.user?.username || username.trim() },
+      });
+    } catch {
+      setError("unavailable");
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <PageBackground variant="login">
+      <div className="absolute right-6 top-6 z-20">
+        <ThemeToggleButton className="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface text-ink-2 shadow-control" />
+      </div>
+      <LoginNetwork cardRef={cardRef} />
+      <div className="relative flex min-h-[100dvh] flex-col items-center justify-center px-6 py-12">
+        <div className="mb-9 flex flex-col items-center text-center">
+          <div className="flex items-center gap-2.5">
+            <LogoMark size={32} />
+            <span className="text-xl font-normal tracking-tight text-ink">
+              {BRAND_NAME_PREFIX}
+              <span className="font-semibold">{BRAND_NAME_SUFFIX}</span>
+            </span>
+          </div>
+          <h1 className="mt-7 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
+            {t("login.hero_prefix")} <RotatingModelName />
+          </h1>
+          <p className="mt-3 max-w-md text-sm leading-6 text-ink-3">{text.description}</p>
+        </div>
