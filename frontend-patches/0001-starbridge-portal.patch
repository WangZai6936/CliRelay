+++ b/pages/login/portalAuth.ts
@@ -0,0 +1,116 @@
+import { portalApi } from "@code-proxy/api-client";
+
+export const portalNavigation = {
+  openLogin: () => window.location.replace("/login"),
+  openWorkspace: () => window.location.replace("/manage/apikey-lookup"),
+  async signOut() {
+    try {
+      await portalApi.logout();
+    } catch {
+      /* Local sign-out must work if the server is unavailable. */
+    } finally {
+      portalApi.clearSession();
+      portalNavigation.openLogin();
+    }
+  },
+};
+
+export async function registrationCapabilities() {
+  const response = await fetch("/v0/portal/auth/registration", {
+    credentials: "omit",
+    cache: "no-store",
+    signal: AbortSignal.timeout(15000),
+  });
+  if (!response.ok) throw new Error("Registration unavailable");
+  return response.json() as Promise<{
+    enabled: boolean;
+    password_min_length: number;
+    password_max_bytes: number;
+  }>;
+}
+
+const copy = {
+  zh: {
